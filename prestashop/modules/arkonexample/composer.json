{
    "autoload": {
        "psr-4": {
            "ArkonExample\\": "src/"
        }
    },
    "config": {
        "autoloader-suffix": "ArkonExample",
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "platform": {
            "php": "8.1.33"
        }
    },
    "require": {
        "php": "^8.1",
        "arkonsoft/ps-module-core": "^1.1",
        "arkonsoft/ps-module-di": "^1.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.2",
        "prestashop/php-dev-tools": "^5"
    },
    "scripts": {
        "analyse": "docker compose -f ../../../docker-compose.yml run --rm phpstan",
        "cs-fix": "docker compose -f ../../../docker-compose.yml run --rm php-cs-fixer"
    },
    "type": "prestashop-module"
}
