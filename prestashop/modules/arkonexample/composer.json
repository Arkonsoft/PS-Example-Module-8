{
    "autoload": {
        "psr-4": {
            "ArkonExample\\": "src/"
        }
    },
    "config": {
        "autoloader-suffix": "ArkonExample",
        "preferred-install": "dist",
        "prepend-autoloader": false
    },
    "require": {
        "php": "^8.1",
        "arkonsoft/ps-module-core": "^1.1",
        "arkonsoft/ps-module-di": "^1.3"
    },
    "scripts": {
        "analyse": "docker compose -f ../../../docker-compose.yml run --rm phpstan"
    },
    "type": "prestashop-module"
}
