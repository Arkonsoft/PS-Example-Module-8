includes:
    - vendor/prestashop/php-dev-tools/phpstan/ps-module-extension.neon

parameters:
    level: 8
    paths:
        - arkonexample.php
        - controllers
        - src
    scanDirectories:
        - vendor/arkonsoft
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Instantiated class Symfony\\Component\\Cache\\Adapter\\FilesystemAdapter not found.#'
